[Unit]
Description=Leafy AI ThingSpeak Sensor Collector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=leafyai
Group=leafyai
WorkingDirectory=/opt/leafyai/backend
EnvironmentFile=/opt/leafyai/.env
ExecStart=/opt/leafyai/venv/bin/python manage.py collect_sensors
Restart=always
RestartSec=5
TimeoutStopSec=20

# Optional hardening; verify paths/permissions on the actual Pi first.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
