# Optional: copy to .env to override local defaults. Do not commit .env.
# `docker compose up --build` works without this file.

# Optional bootstrap/service account. If both are set, `seed_base` creates this
# account on a fresh database and Camera/CV/Sensors can use it for JWT login.
# Leave blank if you prefer to sign up/login manually and provide tokens later.
LEAFY_BOOTSTRAP_USERNAME=
LEAFY_BOOTSTRAP_PASSWORD=
LEAFY_BOOTSTRAP_EMAIL=

# Frontend / Backend
VITE_BACKEND_BASEURL=http://127.0.0.1:8000
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long

# Farm metadata only. `seed_base` creates farm levels and sensors, NEVER a Camera.
LEAFY_FARM_NAME=LeafyAI Farm
LEAFY_FARM_LOCATION=Melbourne
LEAFY_RACK_NAME=LeafyAI Grow Rack

# Camera/CV worker tuning. No camera IP/path belongs here.
LEAFY_CAMERA_POLL_SECONDS=10
LEAFY_CAMERA_HTTP_TIMEOUT=15
LEAFY_CAMERA_JPEG_QUALITY=92
LEAFY_CAMERA_WARMUP_FRAMES=12
LEAFY_CV_POLL_SECONDS=15
FARM_CAMERA_USER=
FARM_CAMERA_PASSWORD=

# Lighting is OFF by default so local Camera/CV work cannot touch power hardware.
LEAFY_LIGHTING_ENABLED=false
LEAFY_LIGHTING_WATCHDOG_SECONDS=30

# Optional hardware profile only. Fill these when running in the Lab.
LEAFY_WATER_QUALITY_URL=http://192.168.1.100/readings
LEAFY_AMBIENT_SENSOR_URL=http://192.168.1.111:8080/readings
LEAFY_SENSOR_POLL_SECONDS=10
LEAFY_SENSOR_HTTP_TIMEOUT=5
LEAFY_POWERBOARD_1_IP=192.168.1.102
LEAFY_POWERBOARD_2_IP=192.168.1.101
LEAFY_KASA_USERNAME=
LEAFY_KASA_PASSWORD=
LEAFY_KASA_DISCOVERY_TIMEOUT=5
LEAFY_KASA_RETRIES=3
LEAFY_KASA_RETRY_DELAY_SECONDS=0.75

# Existing AI/VLM apps remain preserved from the team repo.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
AI_PROVIDER=openrouter
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
VLM_PROVIDER=openrouter
VLM_MODEL=google/gemini-3.1-flash-lite-image
VLM_REQUEST_TIMEOUT_SECONDS=120
