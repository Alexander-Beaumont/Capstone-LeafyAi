# LeafyAI main development configuration.
# This project is configured to read this file directly for local development.

# Frontend development API target.
VITE_BACKEND_BASEURL=http://127.0.0.1:8000

# Shared OpenRouter connection used by both agents.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
AI_PROVIDER=openrouter
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
VLM_PROVIDER=openrouter
VLM_MODEL=google/gemini-3.1-flash-lite-image
VLM_REQUEST_TIMEOUT_SECONDS=120

# Django.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,Leafy-AI.local
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://Leafy-AI.local:5173

# LeafyAI farm/device bootstrap.
LEAFY_FARM_NAME=LeafyAI
LEAFY_FARM_LOCATION=Lab
LEAFY_DEVICE_NAME=LeafyAI Device
LEAFY_DEVICE_TYPE=hydroponic_controller
SENSOR_INGEST_DEVICE_SLUG=test-device

LEAFY_WATER_QUALITY_URL=http://192.168.1.100/readings
LEAFY_AMBIENT_SENSOR_URL=http://192.168.1.111:8080/readings

SENSOR_INGEST_POLL_SECONDS=30
SENSOR_INGEST_EXPECTED_INTERVAL_SECONDS=30
SENSOR_INGEST_SENSOR_STALE_SECONDS=120

SENSOR_INGEST_HTTP_TIMEOUT_SECONDS=5
SENSOR_INGEST_HTTP_RETRY_TOTAL=4
SENSOR_INGEST_HTTP_RETRY_BACKOFF=0.5
SENSOR_INGEST_FAILURE_BACKOFF_BASE_SECONDS=5
SENSOR_INGEST_FAILURE_BACKOFF_MAX_SECONDS=300
SENSOR_INGEST_LOG_LEVEL=INFO

# Camera capture runtime.
LEAFY_CAMERA_TIMEZONE=Australia/Melbourne
LEAFY_CAMERA_POLL_SECONDS=30
LEAFY_CAMERA_JPEG_QUALITY=92
LEAFY_CAMERA_WARMUP_FRAMES=12

FARM_CAMERA_USER=
FARM_CAMERA_PASSWORD=

# Physical Kasa powerboards.
LEAFY_POWERBOARD_1_IP=192.168.1.102
LEAFY_POWERBOARD_2_IP=192.168.1.101

LEAFY_KASA_USERNAME=
LEAFY_KASA_PASSWORD=
LEAFY_KASA_DISCOVERY_TIMEOUT=5
LEAFY_KASA_RETRIES=3
LEAFY_KASA_RETRY_DELAY_SECONDS=0.75

# Background sensor + camera workers.
LEAFY_RUNTIME_ENABLED=true

# Farm-state sensor trend window.
FARM_STATE_SENSOR_TREND_WINDOW_MINUTES=30





# Camera 1 bootstrap/configuration.
LEAFY_CAMERA_1_NAME=Camera Level 1
LEAFY_CAMERA_1_LEVEL=1
LEAFY_CAMERA_1_IP=192.168.1.108
LEAFY_CAMERA_1_RTSP_PORT=554
LEAFY_CAMERA_1_RTSP_PATH=/stream1
LEAFY_CAMERA_1_CAPTURE_INTERVAL_MINUTES=30
LEAFY_CAMERA_1_ENABLED=true
LEAFY_CAMERA_1_CV_ENABLED=true